<div class="cmp-teaser " id="teaser-0e870ed7f7">


        <div class="cmp-teaser__image">

    <div data-asset="/assets-f/img/1a0b69f09cc719.jpg" data-background-image="false" data-dynamic-media-image="false" data-lazy-loaded="true" data-src="/assets-f/img/14204fe7d6f830.jpg" data-widths="128,256,512,1024,1280,1440,1920,2048" id="image-e08ced5400" class="cmp-image" itemscope="" itemtype="http://schema.org/ImageObject">

