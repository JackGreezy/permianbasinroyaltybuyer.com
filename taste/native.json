{
  "classes": {
    "#contact-form label": "eyebrow",
    "#contact-form button[type=submit]": "cmp-button",
    "[data-rr-taste-prose]": "cmp-text"
  },
  "remove": {
    "all": [
      ".cmp-carousel .cmp-hero-banner__cta",
      ".cmp-carousel__action--pause",
      ".cmp-carousel__action--play",
      ".cmp-related-articles__mobile-cta",
      ".cmp-related-projects__mobile-cta",
      "header .rr-header-submenu li:-soup-contains('View All')"
    ],
    "slug": []
  },
  "slug_order": [
    "faq",
    "related",
    "cta"
  ],
  "slug_mounts": {
    "faq": "main.main-wrapper",
    "related": "main.main-wrapper",
    "cta": "main.main-wrapper"
  },
  "templates": {
    "faq": "<div class=\"section cmp-section--site-width-1248\"><div class=\"cmp-section\"><div class=\"cmp-section__container\"><div class=\"text\"><div class=\"cmp-text\"><p class=\"eyebrow\">{kicker}</p><h3>{heading}</h3></div></div><div class=\"grid-container cmp-grid-container--2col-6 cmp-grid-container--padded-top-bottom-small\"><div class=\"cmp-grid-container\"><div class=\"cmp-grid-container__items\"><div class=\"aem-Grid aem-Grid--12 aem-Grid--default--12\">{items}</div></div></div></div></div></div></div>",
    "faq_item": "<div class=\"text aem-GridColumn aem-GridColumn--default--12\"><div class=\"cmp-text\"><h4>{q}</h4>{a}</div></div>",
    "related": "<div class=\"related-projects cmp-related-projects--type-carousel-alternate\"><div class=\"cmp-related-projects\"><div class=\"cmp-related-projects__wrapper\"><div class=\"cmp-related-projects__content\"><div class=\"cmp-related-projects__content-wrapper\"><h2>{heading}</h2></div><div class=\"cmp-related-projects__cta\"><a class=\"cmp-button\" href=\"{all_href}\"><span class=\"cmp-button__text\">{all_label}</span></a></div></div><div class=\"cmp-related-projects__posts\"><div class=\"cmp-related-projects__posts-wrapper\">{items}</div></div></div></div></div>",
    "related_item": "<div class=\"teaser\"><a class=\"article-teaser__action-link\" href=\"{href}\"><div class=\"article-teaser\"><div class=\"article-teaser__content\"><div class=\"article-teaser__project-description\"><h3>{name}</h3><p>{teaser}</p></div></div></div></a></div>",
    "cta": "<div class=\"section cmp-section--site-width-824\"><div class=\"cmp-section\"><div class=\"cmp-section__container\"><div class=\"text cmp-text--text-white\"><div class=\"cmp-text\"><p class=\"eyebrow\">{kicker}</p><h2>{title}</h2><p><span class=\"para-lrg\">{intro}</span></p><p><a class=\"cmp-button\" href=\"{contact_href}\"><span class=\"cmp-button__text\">{label}</span></a><a class=\"cmp-button\" href=\"{tel_href}\"><span class=\"cmp-button__text\">Call {phone}</span></a></p></div></div></div></div></div>"
  }
}